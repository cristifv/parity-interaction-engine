# Copied to .env by spike/run.sh (the host user, so files in spike/out stay the user's).
SPIKE_UID=1000
SPIKE_GID=1000
# parity-ms's control port: docker0, non-loopback but not on the LAN (ADR 0002 S7).
MS_CONTROL=172.17.0.1:2223
# Absolute path of compose/chromium-seccomp.json (docker reads it client-side).
SPIKE_SECCOMP=/path/to/parity-interaction-engine/compose/chromium-seccomp.json
